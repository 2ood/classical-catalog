# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://classical:classical@127.0.0.1:5432/classical
# Where uploaded PDF scores are stored (optional; default storage/scores)
SCORES_DIR=
# Spotify Connect (optional): client ID of your Spotify developer app
SPOTIFY_CLIENT_ID=
# Must match the redirect URI registered for the app
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
